{
  "name": "@spyglass/studio",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone reporting studio — a small query interface + report editor over the spyglass engine and @spyglass/ui widgets. Reports persist in IndexedDB; import/export as JSON.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@spyglass/ui": "workspace:*",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^5.4.11"
  }
}
