# The analyst needs a distri workspace. These stay in the Vite dev server
# (no VITE_ prefix = never sent to the browser); /api/token mints a
# short-lived token from them. Without them the report, drilling and exports
# still work; the analyst panel explains what is missing.
DISTRI_BASE_URL=https://api.distri.dev/v1
DISTRI_API_KEY=
DISTRI_WORKSPACE_ID=

# Public
VITE_DISTRI_API_URL=https://api.distri.dev/v1
VITE_DISTRI_AGENT=spyglass_analyst
