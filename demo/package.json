{
  "name": "@spyglass/demo",
  "version": "0.1.0",
  "private": true,
  "description": "Ask-your-data demo: a distri analyst agent builds and drills @spyglassjs/ui reports over a dataset that lives in the browser (spyglass compiler in WASM + DuckDB-WASM). No server.",
  "type": "module",
  "scripts": {
    "wasm": "cd ../wasm && wasm-pack build --target web --release",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@distri/core": "0.4.5",
    "@distri/react": "0.4.6",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@spyglassjs/ui": "workspace:*",
    "lucide-react": "^0.460.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "vite": "^5.4.11"
  }
}
