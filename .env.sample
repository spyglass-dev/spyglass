# Copy to `.env` and fill in. The spyglass-server binary reads these from the
# environment (it does not auto-load `.env`); export them or use a loader such
# as `direnv`, `dotenvx`, or `set -a; source .env; set +a`.

# ─── Required ────────────────────────────────────────────────────────────────
# Postgres connection string. Used by the runtime server (POST /query) and by
# the OFFLINE admin subcommands (schema / analyze / bundle).
DATABASE_URL=postgres://user:password@localhost:5432/mydb

# ─── Optional (defaults shown) ───────────────────────────────────────────────
# Directory the server loads cube YAML from. Point at ./examples to serve the
# bundled demo cubes, or at the directory where distri writes your own.
REPORTING_CUBES=./examples

# Directory the server writes query logs to.
REPORTING_LOGS=./logs

# Address the runtime server binds to.
REPORTING_ADDR=127.0.0.1:8088
