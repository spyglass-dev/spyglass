# Copy to `.env` (gitignored). Used by the serve/validate/distri scripts here.

# ─── Pagila (the Docker dataset from ./setup.sh) ─────────────────────────────
export DATABASE_URL=postgres://postgres:postgres@localhost:5438/pagila

# ─── Spyglass server (resolve under tests/pagila via `-C tests/pagila`) ──────
export REPORTING_CUBES=./cubes
export REPORTING_REPORTS=./reports
export REPORTING_LOGS=./logs
export REPORTING_ADDR=127.0.0.1:8089

# ─── distri (only needed for analyze-with-distri.sh) ─────────────────────────
# Get these from your Distri workspace. NOT committed.
export DISTRI_API_KEY=
export DISTRI_BASE_URL=https://api-dev.distri.dev/v1
export DISTRI_WORKSPACE_ID=
